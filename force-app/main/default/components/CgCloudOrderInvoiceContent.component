<apex:component controller="TPB_OnlineAppController">
    <apex:attribute name="showActions" type="Boolean" default="true" description="Show action buttons" />

    <head>
        <style>
            body {
                font-family: Arial, sans-serif;
                margin: 30px;
            }

            .invoice-container {
                font-family: Arial, sans-serif;
                margin: 10px;
            }

            .invoice-number {
                font-size: 18px;
                font-weight: bold;
            }

            .section-title {
                font-weight: bold;
                font-size: 16px;
                margin-bottom: 5px;
            }

            .order-confirmation-title {
                text-align: center;
                font-size: 20px;
                font-weight: bold;
                margin-top: 5px;
                margin-bottom: 5px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
            }

            th, td {
                border: 1px solid #ccc;
                padding: 6px;
                text-align: left;
                vertical-align: top;
                word-wrap: break-word;
                overflow-wrap: anywhere;
            }

            th {
                background: #2980b9;
                color: white;
            }

            .no-print {
                margin-bottom: 10px;
                text-align: right;
            }

            .print-button {
                background: #2980b9;
                color: #fff;
                border: 1px solid #1f6a99;
                padding: 6px 12px;
                border-radius: 3px;
                cursor: pointer;
                font-size: 12px;
                display: inline-block;
                text-decoration: none;
            }

            .print-button:hover {
                background: #1f6a99;
            }

            @media (max-width: 1024px) {
                body {
                    margin: 16px;
                }

                .invoice-container {
                    margin: 6px;
                }

                .invoice-number {
                    font-size: 16px;
                }

                .section-title {
                    font-size: 14px;
                }

                .order-confirmation-title {
                    font-size: 16px;
                }

                th, td {
                    padding: 4px;
                    font-size: 11px;
                }

                h4 {
                    font-size: 12px;
                    margin-top: 0.75em;
                }
            }

            @media (max-width: 768px) {
                body {
                    margin: 12px;
                }

                th, td {
                    font-size: 10px;
                }

                .order-confirmation-title {
                    font-size: 14px;
                }
            }

            /* Hide print button when printing */
            @media print {
                .no-print {
                    display: none;
                }

                @page {
                    size: A4;
                    margin: 15mm;
                }
            }
        </style>
        <script>
            function downloadInvoice() {
                var orderId = '{!JSENCODE(orderId)}';
                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.TPB_OnlineAppController.generateInvoiceAndGetDocumentId}',
                    orderId,
                    function(result, event) {
                        if (event.status) {
                            if (result) {
                                if (typeof sforce !== 'undefined' && sforce.one) {
                                    sforce.one.navigateToSObject(result);
                                } else {
                                    window.open('/' + result, '_blank');
                                }
                            } else {
                                alert('Unable to generate PDF.');
                            }
                        } else {
                            alert(event.message);
                        }
                    },
                    { escape: false }
                );
            }
        </script>
    </head>
    <div class="invoice-container">
        <apex:outputPanel rendered="{!showActions}">
            <div class="no-print">
                <button type="button" class="print-button" onclick="downloadInvoice();">Print / Download PDF</button>
            </div>
        </apex:outputPanel>
        <div style="text-align: center;">
            <apex:outputPanel rendered="{!logoUrl != null}">
                <apex:image value="{!URLFOR($Resource.invoiceLogo)}"
                    style="height:70px;" />
            </apex:outputPanel>
        </div>

        <!-- Invoice Number -->
        <div style="text-align: left;">
            <span class="invoice-number">
                Invoice# {!pdf.orderNumber}
            </span>
        </div>

        <!-- HEADER TABLE -->
        <table width="100%" style="border-collapse: collapse; margin-bottom:5px;" border="1">
            <tr>
                <td width="50%">
                    Invoice Date:
                    <apex:outputText value="{0,date,MM'/'dd'/'yyyy}">
                        <apex:param value="{!pdf.invoiceDate}" />
                    </apex:outputText>
                </td>
                <td width="50%">
                    Delivery Date:
                    <apex:outputText value="{0,date,MM'/'dd'/'yyyy}">
                        <apex:param value="{!pdf.deliveryDate}" />
                    </apex:outputText>
                </td>
            </tr>
            <tr>
                <td>Division: {!pdf.division}</td>
                <td>Other NTC License #: {!pdf.otherLicenseNum}</td>
            </tr>
            <tr>
                <td>Company Address: {!pdf.address}</td>
                <td>NTC State Use Tax #: {!pdf.stateTax}</td>
            </tr>
            <tr>
                <td>Owner: {!pdf.ownerName}</td>
                <td>NTC Tax ID: {!pdf.ntcTaxID}</td>
            </tr>
            <tr>
                <td>Distributor License #: {!pdf.distributorLicenceNumber}</td>
                <td>Service Territory: {!pdf.serviceTerritory}</td>
            </tr>
        </table>

        <!-- STORE DETAIL TITLE -->
        <div class="section-title">
            Store Detail
        </div>

        <!-- STORE TABLE -->
        <table width="100%" style="border-collapse: collapse;" border="1">
            <tr>
                <td width="50%">Account: {!pdf.storeName}</td>
                <td width="50%">State Tobacco Number: {!pdf.storeStateTobaccoNum}</td>
            </tr>
            <tr>
                <td>Address: {!pdf.storeAddress}</td>
                <td>State Tax Number: {!pdf.storeStateTaxNum}</td>
            </tr>
            <tr>
                <td>Phone: {!pdf.storePhone}</td>
                <td>FEIN: {!pdf.storefein}</td>
            </tr>
        </table>


        <!-- <h2 style="text-align:center; margin-top:2em;">Order Confirmation</h2> -->
        <div class="order-confirmation-title">
            Order Confirmation
        </div>

        <!-- Cash Sales -->
        <apex:outputPanel rendered="{!NOT(ISNULL(pdf.orderItemsCashSale))}">
            <h4>Cash Sales</h4>
            <table border="1" cellspacing="0" cellpadding="4" width="100%">
                <thead>
                    <tr style="background:#2980b9; color:#fff;">
                        <th>Product</th>
                        <!-- <th>SKU</th> -->
                        <th>Qty</th>
                        <th>Unit</th>
                        <th>Unit Price</th>
                        <th>Promo Code Applied</th>
                        <th>Discount</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!pdf.orderItemsCashSale}" var="item">
                        <tr>
                            <td>{!item.cgcloud__Product__r.Name}</td>
                            <!-- <td>{!item.TPB_SKU__c}</td> -->
                            <td>{!item.cgcloud__Quantity__c}</td>
                            <td>{!item.cgcloud__UoM__c}</td>
                            <td>
                                <apex:outputText value="{0,number,0.00}">
                                    <apex:param value="{!item.FInal_Unit_Price__c}" />
                                </apex:outputText>
                            </td>
                            <td>{!item.cgcloud__Promotion__r.cgcloud__Slogan__c}</td>
                            <td>{!item.Reimbursable_Amt__c}</td>
                            <td>
                                <apex:outputText value="{0,number,0.00}">
                                    <apex:param value="{!item.cgcloud__Value__c}" />
                                </apex:outputText>
                            </td>
                        </tr>
                    </apex:repeat>
                    <tr>
                        <td colspan="1"><strong>Sub Total</strong></td>
                        <td>
                            <apex:outputText value="{0,number,0.##}">
                                <apex:param value="{!pdf.cashSalesQtyTotal}" />
                            </apex:outputText>
                        </td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>
                            <apex:outputText value="{0,number,0.00}">
                                <apex:param value="{!pdf.cashSalesDiscountTotal}" />
                            </apex:outputText>
                        </td>
                        <td>
                            <apex:outputText value="{0,number,0.00}">
                                <apex:param value="{!pdf.cashSalesSubtotal}" />
                            </apex:outputText>
                        </td>
                    </tr>
                </tbody>
            </table>
        </apex:outputPanel>

        <!-- Return -->
        <apex:outputPanel rendered="{!NOT(ISNULL(pdf.orderItemsReturn))}">
            <h4 style="margin-top:2em;">Return</h4>
            <table border="1" cellspacing="0" cellpadding="4" width="100%">
                <thead>
                    <tr style="background:#2980b9; color:#fff;">
                        <th>Product</th>
                        <!-- <th>SKU</th> -->
                        <th>Qty</th>
                        <th>Unit</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!pdf.orderItemsReturn}" var="item">
                        <tr>
                            <td>{!item.cgcloud__Product__r.Name}</td>
                            <!-- <td>{!item.TPB_SKU__c}</td> -->
                            <td>{!item.cgcloud__Quantity__c}</td>
                            <td>{!item.cgcloud__UoM__c}</td>
                            <td>{!item.FInal_Unit_Price__c}</td>
                            <td>
                                <apex:outputText value="{0,number,0.00}">
                                    <apex:param value="{!item.cgcloud__Value__c}" />
                                </apex:outputText>
                            </td>
                        </tr>
                    </apex:repeat>
                    <tr>
                        <td colspan="1"><strong>Sub Total</strong></td>
                        <td>
                            <apex:outputText value="{0,number,0.##}">
                                <apex:param value="{!pdf.returnQtyTotal}" />
                            </apex:outputText>
                        </td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                        <td>
                            <apex:outputText value="{0,number,0.00}">
                                <apex:param value="{!pdf.returnSubtotal}" />
                            </apex:outputText>
                        </td>
                    </tr>
                </tbody>
            </table>
        </apex:outputPanel>

        <!-- Prebook -->
        <apex:outputPanel rendered="{!NOT(ISNULL(pdf.orderItemsPrebook))}">
            <h4 style="margin-top:2em;">Prebook</h4>
            <table border="1" cellspacing="0" cellpadding="4" width="100%">
                <thead>
                    <tr style="background:#2980b9; color:#fff;">
                        <th>Wholesaler Name</th>
                        <!-- <th>SKU</th> -->
                        <th>Product</th>
                        <th>Qty</th>
                        <th>Unit</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!pdf.orderItemsPrebook}" var="item">
                        <tr>
                            <td>{!item.Prebook_Wholesaler__r.Name}</td>
                            <!-- <td>{!item.TPB_SKU__c}</td> -->
                            <td>{!item.cgcloud__Product__r.Name}</td>
                            <td>{!item.cgcloud__Quantity__c}</td>
                            <td>{!item.cgcloud__UoM__c}</td>
                        </tr>
                    </apex:repeat>
                    <tr>
                        <td colspan="2"><strong>Sub Total</strong></td>
                        <td>
                            <apex:outputText value="{0,number,0.##}">
                                <apex:param value="{!pdf.prebookQtyTotal}" />
                            </apex:outputText>
                        </td>
                        <td>&nbsp;</td>
                    </tr>
                </tbody>
            </table>
        </apex:outputPanel>

        <div style="margin-top:1.5em;">
            <strong>Total: {!pdf.qty}</strong><br/>
            <strong>
                <apex:outputText value="Invoice Total: ${0,number,0.00} USD">
                    <apex:param value="{!pdf.invoiceTotal}" />
                </apex:outputText>
            </strong>
        </div>

        <h4 style="margin-top:2em;">Terms</h4>
        <p style="font-size:8pt; max-width:500px;">
            {!pdf.terms}
        </p>

    </div>

</apex:component>