<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Current_C_Fund_Balance__c</fullName>
    <formula>(NULLVALUE(TPB_Balance__c , 0) * -1)+ NULLVALUE(TPB_Reimbursements_Issued__c , 0)+
        NULLVALUE(TPB_Reimbursements_Pending__c, 0) +
        (NULLVALUE(TPB_Inventory_Adjustment_Amount__c,0) * -1) + NULLVALUE(Base_C_Fund_Amount__c ,
        0) +
        NULLVALUE(TPB_Current_CFund_Adjustment__c , 0)</formula>
    <inlineHelpText>Real-time update of Cash on Hand + Bank Balance + Reimbursements Issued +
        Reimbursements Pending + Base C-Fund Amount</inlineHelpText>
    <label>Cash &amp; Cash Equivalents</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <type>Currency</type>
</CustomField>
