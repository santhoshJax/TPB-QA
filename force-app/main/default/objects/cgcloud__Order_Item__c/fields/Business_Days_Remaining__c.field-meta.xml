<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Business_Days_Remaining__c</fullName>
    <externalId>false</externalId>
    <formula>(5 * FLOOR((DATE(2025, 1, 4) - TODAY()) / 7)) +
MIN(5, MOD(DATE(2025, 1, 4) - TODAY(), 7) -
IF(
MOD(TODAY() - DATE(1900, 1, 7), 7) + MOD(DATE(2025, 1, 4) - DATE(1900, 1, 7), 7) &gt; 5,
2,
0
)) - 
IF(TODAY() &lt;= DATE(2024, 12, 24), 1, 0) - 
IF(TODAY() &lt;= DATE(2024, 12, 25), 1, 0) - 
IF(TODAY() &lt;= DATE(2025, 1, 1), 1, 0)+1</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Business Days Remaining</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
