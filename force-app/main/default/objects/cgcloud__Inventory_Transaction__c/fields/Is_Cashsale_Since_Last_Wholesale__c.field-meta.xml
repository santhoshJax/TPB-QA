<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Is_Cashsale_Since_Last_Wholesale__c</fullName>
    <formula>AND(
  cgcloud__Inventory_Transaction_Template__r.Name = &apos;TPB Transaction Template (Cashsale)&apos;,
  OR(
    ISBLANK(cgcloud__Inventory__r.Last_Purchase_Date__c),
    cgcloud__Charge_Date__c &gt; cgcloud__Inventory__r.Last_Purchase_Date__c
  )
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is Cashsale Since Last Wholesale</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
