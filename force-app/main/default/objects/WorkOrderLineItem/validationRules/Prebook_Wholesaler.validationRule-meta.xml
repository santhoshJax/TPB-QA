<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prebook_Wholesaler</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISPICKVAL(Item_Type__c, &quot;Prebook&quot;),
ISBLANK(Wholesaler_OLD__c)
)</errorConditionFormula>
    <errorMessage>You must select a wholesaler for prebook items.</errorMessage>
</ValidationRule>
