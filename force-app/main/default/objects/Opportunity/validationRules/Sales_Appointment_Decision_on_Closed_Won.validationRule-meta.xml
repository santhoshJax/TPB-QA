<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sales_Appointment_Decision_on_Closed_Won</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
IsWon,
ISBLANK(TEXT(Need_Sales_Appointment__c))
)</errorConditionFormula>
    <errorDisplayField>Need_Sales_Appointment__c</errorDisplayField>
    <errorMessage>Please determine if a sales appointment is needed.</errorMessage>
</ValidationRule>
