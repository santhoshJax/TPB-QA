<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Visits_Remaining__c</fullName>
    <externalId>false</externalId>
    <formula>MAX(
  0,
  IF(
    ISBLANK(Frequency__c),
    0,
    VALUE(Frequency__c)
  ) - Completed_Visit_Count__c
)</formula>
