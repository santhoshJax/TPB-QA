<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sales_Cycle_End_Date__c</fullName>
    <formula>IF(
  TODAY() &gt;= DATE(2026, 1, 4) &amp;&amp; TODAY() &lt;= DATE(2026, 4, 4),
  DATE(2026, 4, 4), /* C1 */
  IF(
    TODAY() &gt;= DATE(2026, 4, 5) &amp;&amp; TODAY() &lt;= DATE(2026, 7, 4),
    DATE(2026, 7, 4), /* C2 */
    IF(
      TODAY() &gt;= DATE(2026, 7, 5) &amp;&amp; TODAY() &lt;= DATE(2026, 10, 3),
      DATE(2026, 10, 3), /* C3 */
      IF(
        TODAY() &gt;= DATE(2026, 10, 4) &amp;&amp; TODAY() &lt;= DATE(2027, 1, 2),
        DATE(2027, 1, 2), /* C4 */
        DATE(2026, 4, 4) /* Fallback */
      )
    )
  )
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Sales Cycle End Date</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Date</type>
</CustomField>
