    <customDetailFormulas>
        <calculatedFormula>IF(
    cgcloud__Order_Item__c.cgcloud__Order_Item_Template__c.Name = &apos;Cash Sale&apos; 
    &amp;&amp; TEXT(cgcloud__Order_Item__c.cgcloud__UoM__c) = &apos;SalesUnit&apos;, 
    cgcloud__Order_Item__c.cgcloud__Quantity__c,

    IF(
        cgcloud__Order_Item__c.cgcloud__Order_Item_Template__c.Name = &apos;Cash Sale&apos; 
        &amp;&amp; TEXT(cgcloud__Order_Item__c.cgcloud__UoM__c) = &apos;ConsumerUnit&apos;, 
        cgcloud__Order_Item__c.cgcloud__Quantity__c / cgcloud__Order_Item__c.cgcloud__Product__c.Eaches_per_Carton__c,

        IF(
            cgcloud__Order_Item__c.cgcloud__Order_Item_Template__c.Name = &apos;Return&apos; 
            &amp;&amp; TEXT(cgcloud__Order_Item__c.cgcloud__UoM__c) = &apos;SalesUnit&apos;, 
            cgcloud__Order_Item__c.cgcloud__Quantity__c * -1,

            IF(
                cgcloud__Order_Item__c.cgcloud__Order_Item_Template__c.Name = &apos;Return&apos; 
                &amp;&amp; TEXT(cgcloud__Order_Item__c.cgcloud__UoM__c) = &apos;ConsumerUnit&apos;, 
                cgcloud__Order_Item__c.cgcloud__Quantity__c * -1 / cgcloud__Order_Item__c.cgcloud__Product__c.Eaches_per_Carton__c,

                IF(
                    cgcloud__Order_Item__c.cgcloud__Order_Item_Template__c.Name = &apos;Free Item&apos; 
                    &amp;&amp; TEXT(cgcloud__Order_Item__c.cgcloud__UoM__c) = &apos;SalesUnit&apos;, 
                    cgcloud__Order_Item__c.cgcloud__Quantity__c,

                    IF(
                        cgcloud__Order_Item__c.cgcloud__Order_Item_Template__c.Name = &apos;Free Item&apos; 
                        &amp;&amp; TEXT(cgcloud__Order_Item__c.cgcloud__UoM__c) = &apos;ConsumerUnit&apos;, 
                        cgcloud__Order_Item__c.cgcloud__Quantity__c / cgcloud__Order_Item__c.cgcloud__Product__c.Eaches_per_Carton__c,
                        
                        NULL
                    )
                )
            )
        )
    )
)</calculatedFormula>
