    <customDetailFormulas>
        <calculatedFormula>IF(
  ISBLANK(Visit.Distance_From_Store__c) 
  || ISBLANK(Visit.Store_Location__Latitude__s) 
  || ISBLANK(Visit.Store_Location__Longitude__s) 
  || ISBLANK(Visit.cgcloud__Geolocation__Latitude__s) 
  || ISBLANK(Visit.cgcloud__Geolocation__Longitude__s),
  &quot;No Geocode Available&quot;,
  IF(
    Visit.Distance_From_Store__c &gt; 1000,
    &quot;&gt;1000 (Invalid Geocode)&quot;,
    IF(
      Visit.Distance_From_Store__c  &lt;= 1,
      &quot;0–1 mile&quot;,
      IF(
        Visit.Distance_From_Store__c  &lt;= 5,
        &quot;1–5 miles&quot;,
        IF(
          Visit.Distance_From_Store__c &lt;= 20,
          &quot;5–20 miles&quot;,
          &quot;20+ miles&quot;
        )
      )
    )
  )
)</calculatedFormula>
        <dataType>Text</dataType>
        <developerName>CDF1</developerName>
        <label>Range</label>
        <scale>2</scale>
    </customDetailFormulas>
    <description>Quick summary of how far the device location was from the store at visit start, grouped into distance ranges.  Default time is Last 60 Days.</description>
