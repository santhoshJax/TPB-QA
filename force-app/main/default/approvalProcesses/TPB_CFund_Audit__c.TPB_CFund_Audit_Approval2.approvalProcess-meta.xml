<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>TPB_Actual_Product_Value__c</field>
        <field>TPB_Cash_On_Hand__c</field>
        <field>TPB_Base_CFund_New__c</field>
        <field>TPB_Status__c</field>
        <field>TPB_Actual_Cash_And_Cash_Equivalent__c</field>
        <field>TPB_Actual_Cash_On_Hand_del__c</field>
        <field>TPB_Audit_Result__c</field>
        <field>TPB_Bank_Balance__c</field>
        <field>TPB_Cash_Variance__c</field>
        <field>TPB_CFund_Change_From_Selling_del__c</field>
        <field>TPB_Expected_Cash_On_Hand_del__c</field>
        <field>TPB_Expected_Product_On_Hand_del__c</field>
        <field>TPB_Product_Variance__c</field>
        <field>TPB_Promotional_Discounts_del__c</field>
        <field>TPB_Promo_Value__c</field>
        <field>TPB_Pending_Reimbursements__c</field>
        <field>TPB_RSM_Name__c</field>
        <field>TPB_Total_Accountable_C_Fund__c</field>
        <field>TPB_Total_Adjustments__c</field>
        <field>TPB_Expected_Cash_Equivalents_New__c</field>
        <field>TPB_Expected_Product_Value_New__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>TPB_RSM_Name__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>RSM Approval</description>
        <label>RSM Approval</label>
        <name>TPB_RSM_Approval</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>TPB_Director_Approval__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Director Approval</description>
        <entryCriteria>
            <booleanFilter>1 OR 2</booleanFilter>
            <criteriaItems>
                <field>TPB_CFund_Audit__c.TPB_Audit_Result__c</field>
                <operation>greaterOrEqual</operation>
                <value>1000</value>
            </criteriaItems>
            <criteriaItems>
                <field>TPB_CFund_Audit__c.TPB_Audit_Result__c</field>
                <operation>lessOrEqual</operation>
                <value>-1000</value>
            </criteriaItems>
        </entryCriteria>
        <label>Director Approval</label>
        <name>Director_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>C-Fund Audit Approval</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2 AND 3 AND 4 AND (5 OR 6)</booleanFilter>
        <criteriaItems>
            <field>TPB_CFund_Audit__c.TPB_Status__c</field>
            <operation>equals</operation>
            <value>Draft,Reject</value>
        </criteriaItems>
        <criteriaItems>
            <field>TPB_CFund_Audit__c.TPB_Bank_Balance__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>TPB_CFund_Audit__c.TPB_Cash_On_Hand__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>TPB_CFund_Audit__c.TPB_RSM_Name__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>TPB_CFund_Audit__c.TPB_Audit_Result__c</field>
            <operation>greaterOrEqual</operation>
            <value>250</value>
        </criteriaItems>
        <criteriaItems>
            <field>TPB_CFund_Audit__c.TPB_Audit_Result__c</field>
            <operation>lessOrEqual</operation>
            <value>-100</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>TPB_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>TPB_RSM_Reject</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>TPB_Approval_In_Progress</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>C-Fund Audit Approval</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
