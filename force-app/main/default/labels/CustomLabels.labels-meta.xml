    <labels>
        <fullName>VisitJobDeleteBatch_Query</fullName>
        <language>en_US</language>
        <protected>false</protected>
        <shortDescription>VisitJobDeleteBatch_Query</shortDescription>
        <value>SELECT Id, Name, ToBeArchived__c, 
       cgcloud__Visit__r.Name, 
       cgcloud__Visit__r.Account_Name__c, 
       cgcloud__Visit__r.ActualVisitEndTime 
FROM cgcloud__Visit_Job__c 
WHERE cgcloud__Visit__r.ActualVisitEndTime &lt;LAST_N_DAYS:210
AND ToBeArchived__c = true 
ORDER BY cgcloud__Visit__r.ActualVisitEndTime DESC</value>
    </labels>
