/**
 * @author Eric Chen
 * @date 2023-06-16
 * @description CON0001729-1310 Update 'Tour' on Inventory Records Generated by CGC Offline
 */
public with sharing class TBP_PopulateInventoryTourBatchSchedule implements Database.Batchable<sObject>, Schedulable {
  //query sql
  private String strQuery;

  /**
   * @description TBP_PopulateInventoryTourBatchSchedule constructor without parameters
   */
  public TBP_PopulateInventoryTourBatchSchedule() {
    this.strQuery = 'SELECT Id, cgcloud__Product__r.TPB_Exclude_From_Base_Pricing__c, cgcloud__Product__r.cgcloud__Criterion_5_Product__c, cgcloud__Product__c, cgcloud__User__c FROM cgcloud__Inventory__c WHERE cgcloud__Tour__c = NULL AND cgcloud__Phase__c = \'Active\' LIMIT 5000';
  }

  /**
   * @description TBP_PopulateInventoryTourBatchSchedule constructor with query parameters
   * @param  strQuery strQuery description
   */
  public TBP_PopulateInventoryTourBatchSchedule(String strQuery) {
    this.strQuery = strQuery;
  }

  /**
   * @description start description
   * @param  bc bc description
   * @return    return description
   */
  public Database.QueryLocator start(Database.BatchableContext bc) {
    return Database.getQueryLocator(strQuery);
  }

  /**
   * @description execute description
   * @param  bC           bC description
   * @param  lstInventory lstInventory description
   */
  public void execute(
    Database.BatchableContext bC,
    List<cgcloud__Inventory__c> lstInventory
  ) {
    if (lstInventory != null && lstInventory.size() > 0) {
      Map<Id, cgcloud__Inventory__c> mapInventory = new Map<Id, cgcloud__Inventory__c>(
        lstInventory
      );
      //get all inventory transactions
      Map<String, Decimal> mapStateClassId = new Map<String, Decimal>();
      List<cgcloud__Inventory_Transaction__c> lstTransaction = [
        SELECT
          Id,
          cgcloud__Inventory__c,
          cgcloud__Order_Document__r.cgcloud__Order_Account__r.ShippingState,
          cgcloud__Inventory__r.cgcloud__Product__r.cgcloud__Criterion_5_Product__c,
          cgcloud__Inventory__r.cgcloud__Product__c,
          cgcloud__Inventory__r.cgcloud__User__c
        FROM cgcloud__Inventory_Transaction__c
        WHERE
          cgcloud__Inventory__c IN :mapInventory.keySet()
          AND cgcloud__Order_Document__c != NULL
        ORDER BY CreatedDate DESC
      ];
      //map inventory id to customer state according to last cgcloud__Inventory_Transaction__c
      Map<Id, String> mapInventoryId2State = new Map<Id, String>();
      for (cgcloud__Inventory_Transaction__c objT : lstTransaction) {
        if (
          String.isNotBlank(
            objT.cgcloud__Order_Document__r.cgcloud__Order_Account__r.ShippingState
          ) && !mapInventoryId2State.containsKey(objT.cgcloud__Inventory__c)
        ) {
          mapInventoryId2State.put(
            objT.cgcloud__Inventory__c,
            objT.cgcloud__Order_Document__r.cgcloud__Order_Account__r.ShippingState
          );

          if (
            objT.cgcloud__Inventory__r.cgcloud__Product__r.cgcloud__Criterion_5_Product__c !=
            null
          ) {
            mapStateClassId.put(
              objT.cgcloud__Inventory__r.cgcloud__Product__r.cgcloud__Criterion_5_Product__c +
              objT.cgcloud__Order_Document__r.cgcloud__Order_Account__r.ShippingState +
              objT.cgcloud__Inventory__r.cgcloud__User__c,
              0
            );
          } else {
            mapStateClassId.put(
              objT.cgcloud__Inventory__r.cgcloud__Product__c +
              objT.cgcloud__Order_Document__r.cgcloud__Order_Account__r.ShippingState +
              objT.cgcloud__Inventory__r.cgcloud__User__c,
              0
            );
          }
        }
      }
      //get Inventory base price
      if (mapStateClassId.size() > 0) {
        for (cgcloud__Inventory__c objInventory : [
          SELECT Id, TPB_AvgPrice__c, TPB_StateClassId__c
          FROM cgcloud__Inventory__c
          WHERE
            TPB_StateClassId__c IN :mapStateClassId.keySet()
            AND TPB_AvgPrice__c > 0
        ]) {
          mapStateClassId.put(
            objInventory.TPB_StateClassId__c,
            objInventory.TPB_AvgPrice__c
          );
        }
      }
      //get tours with warehouse state
      List<cgcloud__Tour__c> lstTour = [
        SELECT Id, cgcloud__Start_Warehouse__r.cgcloud__State__c
        FROM cgcloud__Tour__c
        WHERE cgcloud__Start_Warehouse__c != NULL
      ];
      //map state to tour id
      Map<String, Id> mapState2TourId = new Map<String, Id>();
      for (cgcloud__Tour__c objTour : lstTour) {
        if (
          String.isNotBlank(
            objTour.cgcloud__Start_Warehouse__r.cgcloud__State__c
          )
        ) {
          mapState2TourId.put(
            objTour.cgcloud__Start_Warehouse__r.cgcloud__State__c,
            objTour.Id
          );
        }
      }
      //update tours on inventory records
      List<cgcloud__Inventory__c> lstInventoryToUpdate = new List<cgcloud__Inventory__c>();
      for (Id strInventoryId : mapInventory.keySet()) {
        if (
          String.isNotBlank(mapInventoryId2State.get(strInventoryId)) &&
          String.isNotBlank(
            mapState2TourId.get(mapInventoryId2State.get(strInventoryId))
          )
        ) {
          cgcloud__Inventory__c objInventory = new cgcloud__Inventory__c(
            Id = strInventoryId,
            cgcloud__Tour__c = mapState2TourId.get(
              mapInventoryId2State.get(strInventoryId)
            )
          );

          //get StateClass data
          String strStateClass = '';
          cgcloud__Inventory__c objInv = mapInventory.get(strInventoryId);
          if (
            objInv.cgcloud__Product__r.cgcloud__Criterion_5_Product__c != null
          ) {
            strStateClass =
              objInv.cgcloud__Product__r.cgcloud__Criterion_5_Product__c +
              mapInventoryId2State.get(strInventoryId) +
              objInv.cgcloud__User__c;
          } else {
            strStateClass =
              objInv.cgcloud__Product__c +
              mapInventoryId2State.get(strInventoryId) +
              objInv.cgcloud__User__c;
          }

          //Assigns a base price
          if (mapStateClassId.containsKey(strStateClass)) {
            objInventory.TPB_AvgPrice__c = objInv.cgcloud__Product__r.TPB_Exclude_From_Base_Pricing__c ==
              true
              ? null
              : mapStateClassId.get(strStateClass);
          }
          lstInventoryToUpdate.add(objInventory);
        }
      }

      if (lstInventoryToUpdate.size() > 0) {
        Database.update(lstInventoryToUpdate);
      }
    }
  }

  /**
   * @description finish description
   * @param  bc bc description
   */
  public void finish(Database.BatchableContext bc) {
  }

  /**
   * @description execute description
   * @param  sc sc description
   */
  public void execute(SchedulableContext sc) {
    Database.executeBatch(new TBP_PopulateInventoryTourBatchSchedule(), 100);
  }
}