/**
 * @author Mi Li
 * @date 3/1/2023
 * @description CON0001729-355 Viewing Recent Invoices
 * Associate the PDF file generated by advanced orders with the corresponding Customer
 */
public with sharing class TPB_AccountRelationPDFBatch implements Database.Batchable<sObject> {
  //Variable Definition
  private String strQuery;
  private DateTime dtDateFrom = DateTime.newInstance(
    Datetime.now().year(),
    Datetime.now().month(),
    Datetime.now().day(),
    0,
    0,
    0
  );
  private DateTime dtDateTo = DateTime.newInstance(
    Datetime.now().year(),
    Datetime.now().month(),
    Datetime.now().addDays(1).day(),
    0,
    0,
    0
  );
  private static final String CONTENT_DOCUMENT_FILETYPE = 'PDF';
  private static final String CONTENT_DOCUMENT_LINK_SHARETYPE = 'I';
  private static final String CONTENT_DOCUMENT_LINK_VISIBILITY = 'AllUsers';

  /**
   * @description Constructor class
   */
  public TPB_AccountRelationPDFBatch() {
    //Find all PricebookEntry data that needs to be generated
    this.strQuery = 'SELECT Id, cgcloud__Order_Account__c FROM cgcloud__Order__c WHERE cgcloud__Phase__c = \'Released\' AND cgcloud__Release_Time__c >=: dtDateFrom AND cgcloud__Release_Time__c <: dtDateTo AND cgcloud__Order_Account__c != null ';
  }

  /**
   * @description Constructor class
   * @param  strQuery statement
   */
  public TPB_AccountRelationPDFBatch(String strQuery) {
    //Creating a Parametric Construction Method
    this.strQuery = strQuery;
  }

  /**
   * @description start description
   * @param   bc     description
   * @return  return description
   */
  public Database.QueryLocator start(Database.BatchableContext bc) {
    return Database.getQueryLocator(strQuery);
  }

  /**
   * @description execute description
   * @param  bc               description
   * @param  lstCgcloudOrder  description
   */
  public void execute(
    Database.BatchableContext bc,
    List<cgcloud__Order__c> lstCgcloudOrder
  ) {
    Map<String, String> mapOrderAndAccount = new Map<String, String>();
    Map<String, String> mapOrderDocumentLink = new Map<String, String>();
    Set<String> setCgcloudOrderId = new Set<String>();
    //Get the Account data associated with Order
    for (cgcloud__Order__c objOrder : lstCgcloudOrder) {
      mapOrderAndAccount.put(objOrder.Id, objOrder.cgcloud__Order_Account__c);
      setCgcloudOrderId.add(objOrder.Id);
    }

    //Query Order-related PDF attachment information
    if (setCgcloudOrderId.size() > 0) {
      List<ContentDocumentLink> lstContentDocumentLink = [
        SELECT Id, ContentDocumentId, LinkedEntityId
        FROM ContentDocumentLink
        WHERE
          LinkedEntityId IN :setCgcloudOrderId
          AND ContentDocument.FileType = :CONTENT_DOCUMENT_FILETYPE
        LIMIT 5000
      ];
      for (ContentDocumentLink objDocumentLink : lstContentDocumentLink) {
        mapOrderDocumentLink.put(
          objDocumentLink.LinkedEntityId,
          objDocumentLink.ContentDocumentId
        );
      }
    }

    //Data rollback when an exception occurs
    Savepoint sp = Database.setSavepoint();
    try {
      List<ContentDocumentLink> lstInsertDocumentLink = new List<ContentDocumentLink>();
      //Associate PDF attachment information to the corresponding Account
      if (mapOrderDocumentLink.size() > 0) {
        for (String strOrderId : mapOrderDocumentLink.KeySet()) {
          if (mapOrderAndAccount.containsKey(strOrderId)) {
            ContentDocumentLink objDocumentLink = new ContentDocumentLink();
            objDocumentLink.ContentDocumentId = mapOrderDocumentLink.get(
              strOrderId
            );
            objDocumentLink.LinkedEntityId = mapOrderAndAccount.get(strOrderId);
            objDocumentLink.ShareType = CONTENT_DOCUMENT_LINK_SHARETYPE;
            objDocumentLink.Visibility = CONTENT_DOCUMENT_LINK_VISIBILITY;
            lstInsertDocumentLink.add(objDocumentLink);
          }
        }
      }
      //insert data
      if (lstInsertDocumentLink.size() > 0) {
        Database.insert(lstInsertDocumentLink, false);
      }
    } catch (Exception ex) {
      Database.rollback(sp);
    }
  }

  /**
   * @description finish description
   * @param  bc bc description
   */
  public void finish(Database.BatchableContext bc) {
    strQuery = '';
  }
}