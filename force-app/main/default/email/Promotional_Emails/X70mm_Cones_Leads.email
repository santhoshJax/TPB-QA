/* Added styles for Turning Point Brands footer */
.tpb-footer {
    background-color: #ffffff;
    padding: 20px 25px;
    font-family: 'Times New Roman', serif;
    color: #333333;
}
.tpb-heading {
    font-size: 24px;
    font-weight: bold;
    text-align: center;
    margin-bottom: 15px;
    color: #111111;
}
.tpb-subheading {
    font-size: 16px;
    text-align: center;
    margin-bottom: 30px;
}
.tpb-columns {
    display: flex;
    justify-content: space-between;
    margin-bottom: 30px;
}
.tpb-column {
    flex: 1;
    padding: 0 15px;
}
.tpb-column-title {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 10px;
    border-bottom: 1px solid #ddd;
    padding-bottom: 5px;
}
.tpb-column-content {
    font-size: 14px;
    line-height: 1.5;
}
.tpb-divider {
    border-top: 1px solid #ddd;
    margin: 20px 0;
}
.tpb-note {
    font-size: 14px;
    margin-bottom: 20px;
}
.tpb-states-list {
    font-size: 14px;
    line-height: 1.4;
}
.tpb-warning {
    font-size: 12px;
    color: #666;
    margin-top: 30px;
    padding-top: 15px;
    border-top: 1px solid #eee;
}
