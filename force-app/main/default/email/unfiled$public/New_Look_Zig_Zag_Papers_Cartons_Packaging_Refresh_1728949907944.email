0px;direction:ltr"&gt;&lt;tr&gt;&lt;![endif]--&gt; &lt;div class="kl-row colstack" style="display:table;table-layout:fixed;width:100%;"&gt; &lt;!--[if true]&gt;&lt;td style="vertical-align:top;width:600px;"&gt;&lt;![endif]--&gt; &lt;div class="kl-column" style="display:table-cell;vertical-align:top;width:100%;"&gt; &lt;div class="mj-column-per-100 mj-outlook-group-fix component-wrapper hlb-wrapper" style="font-size:0px;text-align:left;direction:ltr;vertical-align:top;width:100%;"&gt; &lt;table border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;" width="100%"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;td class="hlb-block-settings-content" style="vertical-align:top;padding-top:9px;padding-right:18px;padding-bottom:9px;padding-left:18px;"&gt; &lt;table border="0" cellpadding="0" cellspacing="0" role="presentation" style="" width="100%"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;td align="top" class="kl-header-link-bar" style="font-size:0px;padding:0px 0px 0px 0px;word-break:break-word;"&gt; &lt;table border="0" cellpadding="0" cellspacing="0" style="color:#000000;font-family:Ubuntu, Helvetica, Arial, sans-serif;font-size:13px;line-height:22px;table-layout:auto;width:100%;border:0;" width="100%"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;td align="center" class="hlb-logo" style="display:table-cell;width:100%;padding-bottom:10px;"&gt; &lt;table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border-spacing:0px;"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;!--[if true]&gt;&lt;td style="width:600px;" bgcolor="transparent"&gt;&lt;![endif]--&gt; &lt;!--[if !true]&gt;&lt;!--&gt;&lt;td style="width:600px;"&gt;&lt;!--&lt;![endif]--&gt; &lt;a href="https://wholesale.zigzag.com/" style="color:#ff873c; font-style:normal; font-weight:bold; text-decoration:none" target="_blank"&gt; &lt;img alt="July Monthly Rollup" src="https://d3k81ch9hvuctc.cloudfront.net/company/S9a8YF/images/afd84e61-9f9b-4772-b1cf-e28b7d563dc9.png" style="border:0; height:auto; line-height:100%; max-width:100%; outline:none; text-decoration:none; display:block; width:100%; background-color:transparent" width="600"/&gt; &lt;/a&gt; &lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;/div&gt; &lt;div class="mj-column-per-100 mj-outlook-group-fix component-wrapper" style="font-size:0px;text-align:left;direction:ltr;vertical-align:top;width:100%;"&gt; &lt;table border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;" width="100%"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;td class="" style="vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;"&gt; &lt;table border="0" cellpadding="0" cellspacing="0" role="presentation" style="" width="100%"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;td style="font-size:0px;word-break:break-word;"&gt; &lt;div style="height:20px;line-height:20px;"&gt; &lt;/div&gt; &lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;/div&gt; &lt;/div&gt; &lt;!--[if true]&gt;&lt;/td&gt;&lt;![endif]--&gt; &lt;/div&gt; &lt;!--[if true]&gt;&lt;/tr&gt;&lt;/table&gt;&lt;![endif]--&gt; &lt;!--[if true]&gt;&lt;table border="0" cellpadding="0" cellspacing="0" width="600" style="width:600px;direction:ltr"&gt;&lt;tr&gt;&lt;![endif]--&gt; &lt;div class="kl-row colstack" style="display:table;table-layout:fixed;width:100%;"&gt; &lt;!--[if true]&gt;&lt;td style="vertical-align:top;width:600px;"&gt;&lt;![endif]--&gt; &lt;div class="kl-column" style="display:table-cell;vertical-align:top;width:100%;"&gt; &lt;div class="mj-column-per-100 mj-outlook-group-fix component-wrapper" style="font-size:0px;text-align:left;direction:ltr;vertical-align:top;width:100%;"&gt; &lt;table border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;" width="100%"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;td class="" style="vertical-align:top;padding-top:9px;padding-right:18px;padding-bottom:9px;padding-left:18px;"&gt; &lt;table border="0" cellpadding="0" cellspacing="0" role="presentation" style="" width="100%"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;td align="left" class="kl-text" style="font-size:0px;padding:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;word-break:break-word;"&gt; &lt;div style="font-family:Helvetica, Arial, sans-serif;font-size:16px;font-style:normal;font-weight:400;letter-spacing:0px;line-height:1.5;text-align:left;color:#393939;"&gt;&lt;p style="margin-bottom:0; margin-left:0; margin-right:0; margin-top:0; padding-bottom:1em"&gt;&lt;span style="font-weight: inherit; font-style: inherit; color: rgb(0, 0, 0);"&gt;Zig-Zag Fam,&lt;/span&gt;&lt;/p&gt; &lt;div&gt; &lt;div&gt;We are excited to announce that beginning Q4 2024, customers will begin to see refreshed packaging on Zig-Zag® Rolling Paper Cartons.&lt;br/&gt;&lt;br/&gt;&lt;/div&gt; &lt;div&gt;This new packaging creates a consistent, high-impact look that will increase visibility, thus making it&nbsp;easier to identify Zig-Zag® Rolling Paper Cartons on store shelves. This change only impacts&nbsp;cartons, with the Zig-Zag® Paper Booklets maintaining their existing iconic look.&lt;br/&gt;&lt;br/&gt;As seen below, Zig-Zag® cartons are transitioning to a predominantly orange color and consistent imagery.&lt;/div&gt; &lt;div&gt;&nbsp;&lt;/div&gt; &lt;div&gt;As the current packaging sells through, you will be able to smoothly replenish because UPCs for all products will remain the same with no additional setup required. The portfolio of SKUs will be rolling out over the next few months and customers should anticipate this transition to be complete by the end of Q1 2025.&lt;br/&gt;&lt;br/&gt;&lt;/div&gt; &lt;div&gt;&lt;em&gt;&lt;strong&gt;Please sell through your existing inventory prior to distributing the new packaging.&lt;/strong&gt;&lt;/em&gt;&lt;br/&gt;&lt;br/&gt;If you require additional information regarding this communication, please contact your sales representative.&nbsp;Thank you for your continued support of Zig-Zag Products and Turning Point Brands.&lt;br/&gt;&lt;br/&gt;&lt;/div&gt; &lt;div&gt;Best,&lt;/div&gt; &lt;div&gt;Zig-Zag Sales Team&lt;/div&gt; &lt;/div&gt; &lt;div&gt;&lt;strong&gt; &lt;p style="margin-bottom:0; margin-left:0; margin-right:0; margin-top:0; padding-bottom:0"&gt;&lt;span style="font-weight: inherit; font-style: inherit;"&gt;&nbsp;&lt;/span&gt;&lt;/p&gt; &lt;/strong&gt;&lt;/div&gt;&lt;/div&gt; &lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;/div&gt; &lt;div class="mj-column-per-100 mj-outlook-group-fix component-wrapper" style="font-size:0px;text-align:left;direction:ltr;vertical-align:top;width:100%;"&gt; &lt;table border="0" cellpadding="0" cellspacing="0" role="presentation" style="width:100%;" width="100%"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;td class="" style="vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;"&gt; &lt;table border="0" cellpadding="0" cellspacing="0" role="presentation" style="" width="100%"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;td align="center" class="kl-image" style="font-size:0px;word-break:break-word;"&gt; &lt;table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border-spacing:0px;"&gt; &lt;tbody&gt; &lt;tr&gt; &lt;td class="kl-img-base-auto-width" style="border:0;padding:0px 0px 0px 0px;width:532px;" valign="top"&gt; &lt;img src="https://d3k81ch9hvuctc.cloudfront.net/company/S9a8YF/images/e66442cb-6521-45a1-954d-2fd9422c15cf.png" style="border:0; height:auto; line-height:100%; max-width:100%; outline:none; text-decoration:none; display:block; font-size:13px; width:100%" width="532"/&gt; &lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;/td&gt; &lt;/tr&gt; &lt;/tbody&gt; &lt;/table&gt; &lt;/div&gt;