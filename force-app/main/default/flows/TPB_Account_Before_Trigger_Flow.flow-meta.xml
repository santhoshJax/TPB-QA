    <description>Before Create and Update. Stamps the Customer account template when blank, and enforces store-to-headquarter parent link authorization: (1) seniority - you cannot set as parent a headquarter owned by someone in a role tier above yours (field &lt; Zone Director &lt; National Director; admins exempt); (2) cross-region links within one division require the shared Zone Director (or admin); (3) cross-division links require an admin. Update 2026-09: added ParentId link governance and seniority block; template-stamp behavior unchanged (guarded behind Template Blank decision).</description>
    <environments>Default</environments>
    <formulas>
        <name>forT_LinkDecision</name>
        <dataType>String</dataType>
        <expression>IF(
  /* 1. KAM running user OR System Admin — always allowed at any level */
  OR(
    {!Get_Running_User.UserRole.DeveloperName} = &quot;Key_Account_Manager&quot;,
    OR(
      {!Get_Running_User.Profile.Name} = &quot;System Administrator&quot;,
      {!Get_Running_User.Profile.Name} = &quot;Junior System Administrator&quot;
    )
  ),
  &quot;ALLOW&quot;,
  IF(
    /* 2. HQ is KAM-owned — KAM chain maintenance rights */
    {!Get_HQ_Owner.UserRole.DeveloperName} = &quot;Key_Account_Manager&quot;,
    &quot;ALLOW&quot;,
    IF(
      /* 3. Region-zone logic only when BOTH owners follow the Region_XXXX pattern */
      AND(
        BEGINS({!Get_Store_Owner.UserRole.DeveloperName}, &quot;Region_&quot;),
        BEGINS({!Get_HQ_Owner.UserRole.DeveloperName}, &quot;Region_&quot;)
      ),
      IF(
        /* 3a. Same region — self-serve */
        MID({!Get_Store_Owner.UserRole.DeveloperName}, 8, 4) = MID({!Get_HQ_Owner.UserRole.DeveloperName}, 8, 4),
        &quot;ALLOW&quot;,
        IF(
          /* 3b. Same zone — Director can uplevel */
          MID({!Get_Store_Owner.UserRole.DeveloperName}, 8, 2) = MID({!Get_HQ_Owner.UserRole.DeveloperName}, 8, 2),
          IF(
            OR(
              OR(
                {!Get_Running_User.Profile.Name} = &quot;System Administrator&quot;,
                {!Get_Running_User.Profile.Name} = &quot;Junior System Administrator&quot;
              ),
              AND(
                NOT(BEGINS({!Get_Running_User.UserRole.DeveloperName}, &quot;Region_&quot;)),
                CONTAINS({!Get_Running_User.UserRole.DeveloperName}, MID({!Get_Store_Owner.UserRole.DeveloperName}, 8, 2))
              )
            ),
            &quot;ALLOW&quot;,
            &quot;BLOCK_REGION&quot;
          ),
          /* 3c. Different zones — admin only */
          IF(
            OR(
              {!Get_Running_User.Profile.Name} = &quot;System Administrator&quot;,
              {!Get_Running_User.Profile.Name} = &quot;Junior System Administrator&quot;
            ),
            &quot;ALLOW&quot;,
            &quot;BLOCK_DIVISION&quot;
          )
        )
      ),
      /* 4. Store or HQ owner is non-Region_ (Director, National, etc.)
            MID zone extraction doesn&apos;t apply — require admin to be safe */
      IF(
        OR(
          {!Get_Running_User.Profile.Name} = &quot;System Administrator&quot;,
          {!Get_Running_User.Profile.Name} = &quot;Junior System Administrator&quot;
        ),
        &quot;ALLOW&quot;,
        &quot;BLOCK_DIVISION&quot;
      )
    )
  )
)</expression>
    </formulas>
    <formulas>
        <description>Returns BLOCK_SENIORITY when the headquarter owner&apos;s role tier is strictly above the acting user&apos;s tier, otherwise OK. Tier ladder derived from role DeveloperName: field (Region_*) = 1; Zone/other Director (Zone|Director|Direcotr|FSD, not Region_) = 2; National Director (name contains National) = 3. System Administrator / Junior System Administrator are exempt (always OK). Fails open (OK) unless the acting user&apos;s tier is a known ladder tier (&gt;=1), so users outside the field/zone/national ladder are never blocked by this rule.</description>
        <name>forT_SeniorityDecision</name>
        <dataType>String</dataType>
        <expression>IF(
  OR(
    {!Get_Running_User.Profile.Name} = &quot;System Administrator&quot;,
    {!Get_Running_User.Profile.Name} = &quot;Junior System Administrator&quot;,
    {!Get_Running_User.UserRole.DeveloperName} = &quot;Key_Account_Manager&quot;
  ),
  &quot;OK&quot;,
  IF(
    AND(
      IF(CONTAINS({!Get_HQ_Owner.UserRole.DeveloperName}, &quot;National&quot;), 3,
       IF(OR(
            CONTAINS({!Get_HQ_Owner.UserRole.DeveloperName}, &quot;Zone&quot;),
            CONTAINS({!Get_HQ_Owner.UserRole.DeveloperName}, &quot;Director&quot;),
            CONTAINS({!Get_HQ_Owner.UserRole.DeveloperName}, &quot;Direcotr&quot;),
            CONTAINS({!Get_HQ_Owner.UserRole.DeveloperName}, &quot;FSD&quot;)
          ), 2,
        IF(BEGINS({!Get_HQ_Owner.UserRole.DeveloperName}, &quot;Region_&quot;), 1, 0)))
      &gt;
      IF(CONTAINS({!Get_Running_User.UserRole.DeveloperName}, &quot;National&quot;), 3,
       IF(OR(
            CONTAINS({!Get_Running_User.UserRole.DeveloperName}, &quot;Zone&quot;),
            CONTAINS({!Get_Running_User.UserRole.DeveloperName}, &quot;Director&quot;),
            CONTAINS({!Get_Running_User.UserRole.DeveloperName}, &quot;Direcotr&quot;),
            CONTAINS({!Get_Running_User.UserRole.DeveloperName}, &quot;FSD&quot;)
          ), 2,
        IF(BEGINS({!Get_Running_User.UserRole.DeveloperName}, &quot;Region_&quot;), 1, 0))),
      IF(CONTAINS({!Get_Running_User.UserRole.DeveloperName}, &quot;National&quot;), 3,
       IF(OR(
            CONTAINS({!Get_Running_User.UserRole.DeveloperName}, &quot;Zone&quot;),
            CONTAINS({!Get_Running_User.UserRole.DeveloperName}, &quot;Director&quot;),
            CONTAINS({!Get_Running_User.UserRole.DeveloperName}, &quot;Direcotr&quot;),
            CONTAINS({!Get_Running_User.UserRole.DeveloperName}, &quot;FSD&quot;)
          ), 2,
        IF(BEGINS({!Get_Running_User.UserRole.DeveloperName}, &quot;Region_&quot;), 1, 0)))
      &gt;= 1
    ),
    &quot;BLOCK_SENIORITY&quot;,
    &quot;OK&quot;
  )
)</expression>
    </formulas>
