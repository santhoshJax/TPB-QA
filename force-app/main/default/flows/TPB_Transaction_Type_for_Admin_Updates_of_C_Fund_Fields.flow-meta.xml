    <formulas>
        <name>BaseCFundAmountCheckValue</name>
        <dataType>Currency</dataType>
        <expression>{!RawDataValue} + {!Input_New_Amount} - {!InputValue}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>InputValue</name>
        <dataType>Currency</dataType>
        <expression>IF({!Select_Field} ==
            {!BaseCFundAmount},NULLVALUE({!GetUserMessage.Base_C_Fund_Amount__c}, 0),
            IF({!Select_Field} ==
            {!CashCashEquivalents},NULLVALUE({!GetUserMessage.Current_C_Fund_Balance__c}, 0),
            IF({!Select_Field} ==
            {!TotalAccountableCFund},NULLVALUE({!GetUserMessage.TPB_Total_Accountable_C_Fund__c},
            0),
            IF({!Select_Field} ==
            {!TotalAdjustments},NULLVALUE({!GetUserMessage.TPB_Total_Adjustments__c}, 0) ,0)
            )
            )
            )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>IsNeedCheck</name>
        <dataType>Boolean</dataType>
        <expression>IF({!Select_Field} == {!BaseCFundAmount} || {!Select_Field} ==
            {!TotalAccountableCFund},true,false)</expression>
    </formulas>
    <formulas>
        <name>RawDataValue</name>
        <dataType>Currency</dataType>
        <expression>IF({!Select_Field} ==
            {!BaseCFundAmount},NULLVALUE({!GetUserMessage.TPB_Base_CFund_Amount_Adjustment__c}, 0),
            IF({!Select_Field} ==
            {!CashCashEquivalents},NULLVALUE({!GetUserMessage.TPB_Current_CFund_Adjustment__c}, 0),
            IF({!Select_Field} ==
            {!TotalAccountableCFund},NULLVALUE({!GetUserMessage.TPB_Total_Accountable_Adj__c}, 0),
            IF({!Select_Field} ==
            {!TotalAdjustments},NULLVALUE({!GetUserMessage.TPB_Total_Adjustments_Amount__c}, 0) ,0)
            )
            )
            )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>UpdateInputValue</name>
        <dataType>Currency</dataType>
        <expression>
            IF({!InputValue}==null,{!Input_New_Amount}+{!RawDataValue},{!Input_New_Amount}-{!InputValue}+{!RawDataValue})</expression>
        <scale>2</scale>
    </formulas>
