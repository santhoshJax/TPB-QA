<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Answer_Found</name>
        <label>Check Compliance Answer Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No compliance answer found (hold value)</defaultConnectorLabel>
        <rules>
            <name>Answer_Found</name>
            <conditionLogic>1</conditionLogic>
            <conditions>
                <leftValueReference>Get_Compliance_Answer.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Latest_Completed_Visit</targetReference>
            </connector>
            <label>Compliance answer found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Compliance_Answer</name>
        <label>Check Compliance Answer Value</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Account_Compliant_No</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Answer is No</defaultConnectorLabel>
        <rules>
            <name>Answer_Is_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Compliance_Answer.cgcloud__Value__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Compliant_Yes</targetReference>
            </connector>
            <label>Answer is Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Is_Latest_Visit</name>
        <label>Check Is Latest Completed Visit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not the latest completed visit</defaultConnectorLabel>
        <rules>
            <name>Is_Latest_Visit</name>
            <conditionLogic>1</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Latest_Completed_Visit.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Compliance_Answer</targetReference>
            </connector>
            <label>This visit is the latest completed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Offline_App</name>
        <label>Scheduled — Is Offline App</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Online (handled by immediate path)</defaultConnectorLabel>
        <rules>
            <name>Is_Offline</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.End_Visit_Online__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Get_Compliance_Survey_List</targetReference>
            </connector>
            <label>Offline app</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Online_App</name>
        <label>Immediate — Is Online App</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Offline (handled by scheduled path)</defaultConnectorLabel>
        <rules>
            <name>Is_Online</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.End_Visit_Online__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Compliance_Survey_List</targetReference>
            </connector>
            <label>Online app</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Survey_List_Found</name>
        <label>Check Compliance Survey List Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Survey list not found</defaultConnectorLabel>
        <rules>
            <name>Survey_List_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_activity_customer.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Compliance_Answer</targetReference>
            </connector>
            <label>Survey list found</label>
        </rules>
    </decisions>
    <description>SAL-476 consolidated compliance flow. Replaces TPB_Trade_Program_Compliance_On_Visit_Complete and TPB_Trade_Program_Compliance_From_Visit. On a Completed Visit for an enrolled Fre Trade Program store, sets Account.Fre_Trade_Program_Compliant__c from the departure compliance survey answer (Yes=true, No=false, N/A/null=hold). Online app (End_Visit_Online__c=TRUE) runs immediately; Offline app (FALSE) runs 10 min after ActualVisitEndTime to allow survey sync. Both paths run identical core logic.</description>
    <environments>Default</environments>
    <interviewLabel>TPB - Visit Trade Program Compliance {!$Flow.CurrentDateTime}</interviewLabel>
    <label>TPB - Visit Trade Program Compliance</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Error</name>
        <label>Log Error to SDF_LGR_Log</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Class__c</field>
            <value>
                <stringValue>TPB_Visit_Trade_Program_Compliance</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Level__c</field>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Message__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Reference__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>SDF_LGR_Log__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>get_activity_customer</name>
        <label>Get Activity Customer (survey assignment)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Survey_List_Found</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>cgcloud__Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>cgcloud__Job_Definition_List__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Compliance_Survey_List.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>cgcloud__Job_Definition_List_Account__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Compliance_Answer</name>
        <label>Get Compliance Survey Answer</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Answer_Found</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Error</targetReference>
        </faultConnector>
        <filterLogic>1 AND 2 AND (3 OR 4)</filterLogic>
        <filters>
            <field>cgcloud__Visit__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>cgcloud__Job_Definition_Template_Description__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Label.TPB_Trade_Program_Compliance_Question_Text</elementReference>
            </value>
        </filters>
        <filters>
            <field>cgcloud__Value__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Yes</stringValue>
            </value>
        </filters>
        <filters>
            <field>cgcloud__Value__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>No</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>cgcloud__Visit_Job__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>cgcloud__Value__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Compliance_Survey_List</name>
        <label>Get Compliance Survey Job List</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>get_activity_customer</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Fre Trade Program Compliance Survey</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>cgcloud__Job_Definition_List__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Latest_Completed_Visit</name>
        <label>Get Latest Completed Visit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Is_Latest_Visit</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Visit</object>
        <queriedFields>Id</queriedFields>
        <sortField>ActualVisitEndTime</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Account_Compliant_No</name>
        <label>Update Account Trade Program Compliant — No</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Log_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Fre_Trade_Program_Compliant__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Account_Compliant_Yes</name>
        <label>Update Account Trade Program Compliant — Yes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <targetReference>Log_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Fre_Trade_Program_Compliant__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Online_App</targetReference>
        </connector>
        <filterFormula>TEXT({!$Record.Status}) = &quot;Completed&quot; &amp;&amp; (ISNEW() || ISCHANGED({!$Record.Status})) &amp;&amp; NOT(ISBLANK(TEXT({!$Record.Account.Fre_Trade_Program_Enrolled__c})))</filterFormula>
        <object>Visit</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Offline_Sync_Delay</name>
            <connector>
                <targetReference>Check_Offline_App</targetReference>
            </connector>
            <label>Offline Sync Delay</label>
            <offsetNumber>10</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>ActualVisitEndTime</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Obsolete</status>
</Flow>
