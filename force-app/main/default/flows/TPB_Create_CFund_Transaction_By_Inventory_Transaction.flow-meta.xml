    <formulas>
        <name>cashAdjustment</name>
        <dataType>Number</dataType>
        <expression>{!$Record.cgcloud__Amount__c} * {!$Record.cgcloud__Inventory__r.TPB_AvgPrice__c} * -1</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>inventoryAdjustment</name>
        <dataType>Number</dataType>
        <expression>{!$Record.cgcloud__Amount__c} * {!$Record.cgcloud__Inventory__r.TPB_AvgPrice__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>retailCashAdjustment</name>
        <dataType>Number</dataType>
        <expression>{!retailPrice} * {!$Record.cgcloud__Amount__c} * -1</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>retailDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.cgcloud__Order_Item__r.cgcloud__Order__r.cgcloud__Release_Time__c})</expression>
    </formulas>
    <formulas>
        <name>retailMultiple</name>
        <dataType>Number</dataType>
        <expression>CASE({!$Record.cgcloud__Order_Item__r.cgcloud__UoM__c}, 
&apos;ConsumerUnit&apos;, {!numEachCarton}, 
1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>retailPrice</name>
        <dataType>Number</dataType>
        <expression>IF({!$Record.cgcloud__Order_Item__r.cgcloud__Special_Price__c} == 0, ABS({!$Record.cgcloud__Order_Item__r.cgcloud__Base_Price__c}), ABS({!$Record.cgcloud__Order_Item__r.cgcloud__Special_Price__c})) * {!retailMultiple}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>retailType</name>
        <dataType>String</dataType>
        <expression>IF({!newCFundTransaction.TPB_Quantity__c} &lt; 0 , &apos;Cash Sale&apos;, &apos;Retail Return&apos;)</expression>
    </formulas>
    <formulas>
        <name>wholesaleCashAdjustment</name>
        <dataType>Number</dataType>
        <expression>{!wholesalePrice} * {!$Record.cgcloud__Amount__c} * -1</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>wholesaleMultiple</name>
        <dataType>Number</dataType>
        <expression>CASE({!newCFundTransaction.TPB_Wholesale_Order_Item__r.UoM__c},
 &apos;Carton&apos;, 1, 
&apos;Each&apos;, {!numEachCarton},
&apos;Case&apos;,{!numEachCarton}/{!numEachCase},
1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>wholesalePrice</name>
        <dataType>Number</dataType>
        <expression>ABS({!$Record.TPB_Wholesale_Order_Item__r.UnitPrice}) * {!wholesaleMultiple}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>wholesaleType</name>
        <dataType>String</dataType>
        <expression>IF({!newCFundTransaction.TPB_Quantity__c} &gt; 0, &apos;Whl Purchase&apos;, &apos;Whl Return&apos;)</expression>
    </formulas>
