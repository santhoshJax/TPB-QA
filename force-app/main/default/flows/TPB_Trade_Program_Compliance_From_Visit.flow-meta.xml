<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Compliance_And_Enrolled</name>
        <label>Check Compliance Question And Enrolled</label>
        <locationX>1799</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Not compliance Q / not enrolled</defaultConnectorLabel>
        <rules>
            <name>Compliance_LEFT_and_Enrolled</name>
            <conditionLogic>1 AND 2</conditionLogic>
            <conditions>
                <leftValueReference>frmQuestionTemplateName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.TPB_Trade_Program_Compliance_Question</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.cgcloud__Visit__r.Account.Fre_Trade_Program_Enrolled__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Compliance_Survey_List</targetReference>
            </connector>
            <label>Compliance LEFT question and enrolled</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Compliance_Answer</name>
        <label>Check Compliance Answer Value</label>
        <locationX>314</locationX>
        <locationY>971</locationY>
        <defaultConnector>
            <targetReference>Update_Account_Compliant_No</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Answer is No (or other)</defaultConnectorLabel>
        <rules>
            <name>Answer_Is_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.cgcloud__Value__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account_Compliant_Yes</targetReference>
            </connector>
            <label>Answer is Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Is_Latest_Visit</name>
        <label>Check Is Latest Completed Visit</label>
        <locationX>710</locationX>
        <locationY>863</locationY>
        <defaultConnectorLabel>Older visit - do not overwrite</defaultConnectorLabel>
        <rules>
            <name>Is_Latest_Visit</name>
            <conditionLogic>1</conditionLogic>
            <conditions>
                <leftValueReference>$Record.cgcloud__Visit__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Latest_Completed_Visit.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Compliance_Answer</targetReference>
            </connector>
            <label>Triggering visit is the latest completed visit</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Survey_List_Found</name>
        <label>Check Compliance Survey List Found</label>
        <locationX>1172</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Survey list not found</defaultConnectorLabel>
        <rules>
            <name>Survey_List_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>get_activity_customer.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Latest_Completed_Visit</targetReference>
            </connector>
            <label>Survey list found</label>
        </rules>
    </decisions>
