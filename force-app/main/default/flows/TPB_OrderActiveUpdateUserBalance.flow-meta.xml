        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>OrderItem_Type_Is_Purchase</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ForEach_All_Orderitem.TPB_Type__c</leftValueReference>
