            </conditions>
            <connector>
                <targetReference>Less_OrderItem_Amount</targetReference>
            </connector>
            <label>OrderItem Type Is Return</label>
        </rules>
    </decisions>
    <description>Update the Balance amount value on the corresponding owner when Order becomes Active</description>
    <environments>Default</environments>
    <formulas>
        <name>Final_Amount</name>
        <dataType>Number</dataType>
        <expression>ABS({!ForEach_All_Orderitem.TotalPrice})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>RemainingAmount</name>
        <dataType>Number</dataType>
        <expression>IF({!Get_User_Data.TPB_Balance__c} == null ||  ISNULL({!Get_User_Data.TPB_Balance__c} )  ,  {!Order_All_Amount} , 
{!Get_User_Data.TPB_Balance__c} +  {!Order_All_Amount})</expression>
        <scale>2</scale>
    </formulas>
