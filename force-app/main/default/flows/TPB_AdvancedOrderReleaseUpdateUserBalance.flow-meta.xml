    <description>Update the Balance amount value on the corresponding owner when Advanced Order
        becomes Release</description>
    <environments>Default</environments>
    <formulas>
        <name>AllAdOrderAmount</name>
        <dataType>Number</dataType>
        <expression>IF({!$Record.cgcloud__Total_Value__c} &gt; 0,
            -ABS({!$Record.cgcloud__Total_Value__c}), ABS({!$Record.cgcloud__Total_Value__c}))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>UpdateAmount</name>
        <dataType>Number</dataType>
        <expression>IF({!Get_User_Data.TPB_Balance__c} == null ||
            ISNULL({!Get_User_Data.TPB_Balance__c}), {!AllAdOrderAmount},
            {!Get_User_Data.TPB_Balance__c} +{!AllAdOrderAmount} )</expression>
        <scale>2</scale>
    </formulas>
