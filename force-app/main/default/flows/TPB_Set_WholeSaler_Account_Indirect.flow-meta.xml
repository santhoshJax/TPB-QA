<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>AccountManagementProfile</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Account Management</stringValue>
        </value>
    </constants>
    <constants>
        <name>TSMProfile</name>
        <dataType>String</dataType>
        <value>
            <stringValue>CG Cloud Mobile - TSM</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Is_Indirect</name>
        <label>Is Indirect</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Set_Is_Indirect_False</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Is_Indirect</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CreatedBy.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AccountManagementProfile</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CreatedBy.Profile.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>TSMProfile</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Is_Indirect_True</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>TPB_Set_WholeSaler_Account_Indirect {!$Flow.CurrentDateTime}</interviewLabel>
    <label>TPB_Set_WholeSaler_Account_Indirect</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Is_Indirect_False</name>
        <label>Set Is_Indirect False</label>
        <locationX>314</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>TPB_Is_Indirect__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Set_Is_Indirect_True</name>
        <label>Set Is_Indirect True</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <inputAssignments>
            <field>TPB_Is_Indirect__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Indirect</targetReference>
        </connector>
        <filterFormula>{!$Record.RecordType.DeveloperName} == &apos;Wholesaler&apos;</filterFormula>
        <object>Account</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>600</triggerOrder>
</Flow>
