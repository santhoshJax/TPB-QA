<?xml version="1.0" encoding="UTF-8"?>
<QuickAction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>New Work Order</description>
    <fieldOverrides>
        <field>AccountId</field>
        <formula>Account.Id</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>EndDate</field>
        <formula>NOW()</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>StartDate</field>
        <formula>DATETIMEVALUE(
TEXT(DATEVALUE(NOW()))
+
&quot; &quot; + TEXT(6 - $User.Time_Zone_Offset__c) &amp; &apos;:00:00&apos;
)</formula>
    </fieldOverrides>
    <fieldOverrides>
        <field>StateCode</field>
        <formula>TEXT(Account.ShippingStateCode)</formula>
    </fieldOverrides>
    <label>Schedule Visit</label>
    <optionsCreateFeedItem>true</optionsCreateFeedItem>
    <quickActionLayout>
        <layoutSectionStyle>TwoColumnsLeftToRight</layoutSectionStyle>
        <quickActionLayoutColumns>
            <quickActionLayoutItems>
                <emptySpace>false</emptySpace>
                <field>AccountId</field>
                <uiBehavior>Edit</uiBehavior>
            </quickActionLayoutItems>
            <quickActionLayoutItems>
                <emptySpace>false</emptySpace>
                <field>StartDate</field>
                <uiBehavior>Edit</uiBehavior>
            </quickActionLayoutItems>
            <quickActionLayoutItems>
                <emptySpace>false</emptySpace>
                <field>EndDate</field>
                <uiBehavior>Edit</uiBehavior>
            </quickActionLayoutItems>
        </quickActionLayoutColumns>
        <quickActionLayoutColumns/>
    </quickActionLayout>
    <targetObject>WorkOrder</targetObject>
    <targetParentField>Account</targetParentField>
    <type>Create</type>
</QuickAction>
